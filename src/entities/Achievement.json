{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usuário autenticado"
    },
    "achievement_type": {
      "type": "string",
      "enum": [
        "first_workout",
        "streak_7",
        "streak_30",
        "100_workouts",
        "1000_calories",
        "perfect_week",
        "early_bird",
        "night_owl",
        "protein_king",
        "consistency_master"
      ],
      "description": "Tipo de conquista"
    },
    "unlocked_date": {
      "type": "string",
      "format": "date",
      "description": "Data de desbloqueio"
    },
    "title": {
      "type": "string",
      "description": "Título da conquista"
    },
    "description": {
      "type": "string",
      "description": "Descrição"
    }
  },
  "required": [
    "user_id",
    "achievement_type"
  ]
}
