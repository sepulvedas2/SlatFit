{
  "name": "WorkoutLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usuário autenticado"
    },
    "workout_id": {
      "type": "string",
      "description": "ID do treino realizado"
    },
    "workout_name": {
      "type": "string",
      "description": "Nome do treino"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "Data de conclusão"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Duração real em minutos"
    },
    "calories_burned": {
      "type": "number",
      "description": "Calorias queimadas"
    },
    "notes": {
      "type": "string",
      "description": "Notas do treino"
    },
    "rating": {
      "type": "number",
      "description": "Avaliação de 1 a 5"
    }
  },
  "required": [
    "user_id",
    "workout_id",
    "workout_name"
  ]
}
