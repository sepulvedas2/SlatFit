{
  "name": "FoodLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usuário autenticado"
    },
    "food_name": {
      "type": "string",
      "description": "Nome do alimento identificado"
    },
    "meal_type": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "snack"
      ],
      "description": "Tipo de refeição"
    },
    "calories": {
      "type": "number",
      "description": "Calorias totais"
    },
    "protein": {
      "type": "number",
      "description": "Proteína em gramas"
    },
    "carbs": {
      "type": "number",
      "description": "Carboidratos em gramas"
    },
    "fats": {
      "type": "number",
      "description": "Gorduras em gramas"
    },
    "portion_size": {
      "type": "string",
      "description": "Tamanho da porção estimado"
    },
    "image_url": {
      "type": "string",
      "description": "URL da foto do alimento"
    },
    "log_date": {
      "type": "string",
      "format": "date",
      "description": "Data do registro"
    }
  },
  "required": [
    "user_id",
    "food_name",
    "calories"
  ]
}
