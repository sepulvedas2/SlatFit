{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do usuário vinculado"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usuário autenticado"
    },
    "height": {
      "type": "number",
      "description": "Altura em cm"
    },
    "current_weight": {
      "type": "number",
      "description": "Peso atual em kg"
    },
    "target_weight": {
      "type": "number",
      "description": "Peso alvo em kg"
    },
    "goal": {
      "type": "string",
      "enum": [
        "weight_loss",
        "muscle_gain",
        "maintenance"
      ],
      "description": "Objetivo principal"
    },
    "activity_level": {
      "type": "string",
      "enum": [
        "sedentary",
        "light",
        "moderate",
        "active",
        "very_active"
      ],
      "description": "Nível de atividade física"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "description": "Gênero"
    },
    "age": {
      "type": "number",
      "description": "Idade"
    },
    "daily_calorie_target": {
      "type": "number",
      "description": "Meta diária de calorias calculada"
    },
    "protein_target": {
      "type": "number",
      "description": "Meta diária de proteína em gramas"
    },
    "carbs_target": {
      "type": "number",
      "description": "Meta diária de carboidratos em gramas"
    },
    "fats_target": {
      "type": "number",
      "description": "Meta diária de gorduras em gramas"
    }
  },
  "required": [
    "email",
    "goal"
  ]
}
