{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usuário autenticado"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free_trial",
        "premium",
        "expired"
      ],
      "default": "free_trial",
      "description": "Plano atual"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de início"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de término"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Status da assinatura"
    },
    "payment_method": {
      "type": "string",
      "description": "Método de pagamento"
    },
    "auto_renew": {
      "type": "boolean",
      "default": true,
      "description": "Renovação automática"
    }
  },
  "required": [
    "user_id"
  ]
}
