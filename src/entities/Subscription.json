{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free_trial",
        "premium",
        "expired"
      ],
      "default": "free_trial",
      "description": "Plano atual"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Status da assinatura"
    },
    "payment_method": {
      "type": "string",
      "description": "M\u00e9todo de pagamento"
    },
    "auto_renew": {
      "type": "boolean",
      "default": true,
      "description": "Renova\u00e7\u00e3o autom\u00e1tica"
    }
  },
  "required": [
    "user_email"
  ]
}