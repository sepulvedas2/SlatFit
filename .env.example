# SlatFit BE API base URL (used by src/api/transport.js).
#
# Local dev: leave empty or omit — Vite proxies API routes, including /billing, to http://localhost:3000
# VITE_API_BASE_URL=
#
# Hosts whose hostname contains "beautiful" or "illustrious" always use
# https://slatfit-be-upsu.onrender.com (runtime check in transport.js).
#
# Other production hosts: set explicitly
# VITE_API_BASE_URL=https://slatfit-be-upsu.onrender.com

# Stripe publishable key only. Keep secret/webhook keys in SlatFit BE.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Public Supabase settings for Google login. Use the SAME project as SlatFit BE.
# Never put service_role, sb_secret_*, or the Google Client Secret in VITE variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
